# ============================================================================
# The Lenny Growth Assistant -- environment configuration
# Copy this file to .env and adjust as needed. Never commit your real .env.
# ============================================================================

# ---- Required ----------------------------------------------------------
# Async SQLAlchemy URL (used by the running app).
DATABASE_URL=postgresql+asyncpg://lenny:lenny@postgres:5432/lenny_growth_assistant
# Sync URL (used only by Alembic migrations).
SYNC_DATABASE_URL=postgresql+psycopg2://lenny:lenny@postgres:5432/lenny_growth_assistant

# Which chat provider the agent uses: "ollama" (default, local, required for
# the demo) or "anthropic" (cloud, optional). Embeddings always use Ollama
# regardless of this setting -- Anthropic has no embeddings API.
LLM_PROVIDER=ollama

# ---- Local model (Ollama) -- required for the default demo path --------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=90

# ---- Cloud model (Anthropic) -- optional --------------------------------
# Leave blank to run entirely on Ollama. If set, switch LLM_PROVIDER=anthropic
# to use it for chat. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=60

# ---- App -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# ---- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_SIMILARITY_THRESHOLD=0.55
EMBEDDING_DIMENSIONS=768
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=60

# ---- Artifacts -------------------------------------------------------------
ARTIFACT_MAX_HTML_BYTES=200000

# ---- Frontend (see frontend/.env.example) ---------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
